{
  "name": "growth-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3201",
    "typecheck": "tsc --noEmit",
    "test:config": "rm -rf .cfgtest && tsc scripts/config-test.ts --outDir .cfgtest --module commonjs --target es2022 --moduleResolution node --skipLibCheck --esModuleInterop --strict --jsx preserve >/dev/null; node .cfgtest/scripts/config-test.js",
    "e2e": "node scripts/e2e-matrix.mjs",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:cov": "vitest run --coverage",
    "cy:open": "cypress open",
    "cy:run:e2e": "cypress run --e2e",
    "cy:run:ct": "cypress run --component",
    "cy:smoke": "cypress run --e2e --spec cypress/e2e/smoke/**/*.cy.ts",
    "ci:smoke": "start-server-and-test \"next start -p 3202\" http://localhost:3202/login cy:smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
