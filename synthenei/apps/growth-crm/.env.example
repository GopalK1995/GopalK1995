# Copy to .env.local. Never commit real values.
# Supabase (server-side only; service role must never reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Data source for screens: "mock" (default, synthetic) | "supabase" (not implemented yet)
DATA_SOURCE=mock
# Backup monitor adapter: "mock" (default) | "supabase" (not implemented yet)
BACKUP_ADAPTER=mock
# GA4 Data API (service account JSON path or secret name; not implemented yet)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_REF=
# Feature flags
FEATURE_LINKEDIN_REAL_API=false
FEATURE_AI_SUMMARIES=false
# Claude API key for AI draft summaries (off by default)
ANTHROPIC_API_KEY=
