# Copy to .env.local. Never commit real values.

# production | staging | demo | test. Unset = demo when no Supabase env, else staging.
# production refuses DEMO_MODE=1 and requires the Supabase keys, SESSION_SECRET (32+ chars) and JOBS_TICK_SECRET.
APP_ENV=demo
APP_BASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
JOBS_TICK_SECRET=
CRON_SECRET=

# --- Supabase (optional). Without these the app runs fully in demo mode on synthetic data. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Read real tables for real (non-demo) sessions: "supabase". Demo sessions always read the mock.
DATA_SOURCE=mock

# --- Security switches (server-only) ---
# Signs the session, workspace and support cookies. REQUIRED when Supabase is configured.
SESSION_SECRET=
# Demo personas on /login and the demo admin MFA step. Leave OFF (unset or 0) for a client production deployment.
# When Supabase is not configured, demo mode is always on (there is nothing real to protect).
DEMO_MODE=0
# Local http testing of a production build only.
INSECURE_COOKIES=0

# --- Later integrations (not implemented) ---
BACKUP_ADAPTER=mock
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_REF=
ANTHROPIC_API_KEY=

# --- WhatsApp Business (T035). Names only: values come from the deployment, never from code. ---
# Graph API base override (staging stub / Cypress). Unset = Meta's default. Version override likewise.
WHATSAPP_API_BASE=
WHATSAPP_API_VERSION=
# Platform Meta app for embedded signup (optional; manual connection needs none of these).
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Webhook handshake token for the Meta callback URL (shared fallback; a connection can also carry its own verify_token).
META_WEBHOOK_VERIFY_TOKEN=
# Optional comma list overriding the Meta OAuth scopes (default: all in constants.ts). Use it while the Meta app lacks a use case, e.g. leads_retrieval.
META_OAUTH_SCOPES=

# --- Meta Lead Ads + Instagram + Ads Insights (T036). Names only: values come from the deployment, never from code. ---
# The platform Meta app (Facebook Login client). The secret also signs webhooks (X-Hub-Signature-256) and appsecret_proof.
META_APP_ID=
META_APP_SECRET=
# Graph API base / version override (staging stub / Cypress insights mock). Unset = Meta default.
META_GRAPH_API_BASE=
META_GRAPH_API_VERSION=
# --- Razorpay, tenant payments (T037). Names only. Tenants paste their own keys in the app (stored encrypted); nothing here is a key. ---
# API base override (staging stub / Cypress). Unset = Razorpay's default. The platform billing RAZORPAY_KEY_* names are a separate feature.
RAZORPAY_API_BASE=

# --- Synthan's own billing (T053). Names only; every value is the platform's, none is a tenant's. ---
# Razorpay Subscriptions for platform plans. TEST keys only (rzp_test_...) until the owner's KYC is done; a live key is refused unless BILLING_RAZORPAY_LIVE=1.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: POST <app>/api/billing/razorpay, events subscription.activated / charged / pending / halted / cancelled / completed.
RAZORPAY_WEBHOOK_SECRET=
BILLING_RAZORPAY_LIVE=
# GST tax invoice issuer. Invoices and checkout are refused until all four are set. BILLING_ADDRESS lines are separated by "|".
BILLING_GSTIN=
BILLING_SAC_CODE=
BILLING_GST_RATE_PERCENT=
BILLING_LEGAL_NAME=
BILLING_ADDRESS=
# Days after the paid period before a past-due organisation turns read-only. Unset = warning only, never read-only.
BILLING_PAST_DUE_GRACE_DAYS=

# --- Email: outbound (Resend / SMTP) and Mailchimp (T038). Names only. Tenants paste their own provider credentials in the app (stored encrypted). ---
# Resend API base override (staging stub / Cypress). Unset = Resend's default.
RESEND_API_BASE=
# Signing key for unsubscribe links (32+ random characters). Required before any email can be sent: mail without a working opt-out is blocked.
EMAIL_UNSUBSCRIBE_SECRET=
# T052 DPDP: key for the sealed email-verification link on the public privacy request form (long random string; unset = the form says unavailable)
PRIVACY_VERIFY_SECRET=
# Platform-level default sender for SYSTEM mail only (invites, notifications). Never used for a tenant's own email; leave empty to disable.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Mailchimp OAuth app (platform-owned) and an optional API base override for stubs.
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
MAILCHIMP_API_BASE=
# --- Google: Analytics 4, Google Ads, Sheets import (T039). Names only: values come from the deployment, never from code. ---
# One Google Cloud OAuth client for all three connectors (redirect URIs: /api/oauth/ga4|google-ads|google-sheets/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Ads developer token (test accounts work before basic access is granted) and an optional manager (MCC) customer id.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# API base / version overrides (staging stub / Cypress mock base URLs). Unset = Google's defaults.
GOOGLE_ADS_API_BASE=
GOOGLE_ADS_API_VERSION=
GA4_DATA_API_BASE=
GA4_ADMIN_API_BASE=
GOOGLE_SHEETS_API_BASE=

# --- LinkedIn Lead Gen Forms + Ads analytics (T044). Names only: values come from the deployment, never from code. ---
# The platform LinkedIn app (OAuth client). Live use needs LinkedIn approval of the Advertising API and Lead Sync products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# API base / version (YYYYMM) override (staging stub / Cypress mock base URL). Unset = LinkedIn defaults.
LINKEDIN_API_BASE=
LINKEDIN_API_VERSION=

# --- Calendly + Cal.com bookings (T047). Names only. Tenants paste their own token / key in the app (stored encrypted). ---
# API base overrides (staging stub / Cypress / self-hosted Cal.com). Unset = the vendor's default.
CALENDLY_API_BASE=
CALCOM_API_BASE=
# --- Google Business Profile (T045). Same OAuth client as T039 (redirect URI /api/oauth/google-business/callback). Base overrides for stubs / Cypress; unset = Google. ---
GBP_ACCOUNTS_API_BASE=
GBP_INFO_API_BASE=
GBP_PERFORMANCE_API_BASE=
GBP_REVIEWS_API_BASE=
# --- AI gateway (T050). Names only: values come from the deployment (or a tenant's own key stored in the Vault), never from code. ---
# Platform keys, used when a tenant has not stored its own (BYOK). Anthropic is the default provider; OpenAI and Google are optional.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Optional API base overrides (staging stubs / Cypress). Unset = the vendor defaults.
ANTHROPIC_API_BASE=
OPENAI_API_BASE=
GOOGLE_AI_API_BASE=
# Staging and Cypress ONLY: 1 = a deterministic mock answers instead of a vendor. Ignored when VERCEL_ENV or NODE_ENV is production.
AI_MOCK_PROVIDER=
# --- Slack alerts (T049). Names only: values come from the deployment, never from code. ---
# The platform Slack app (OAuth v2 client + signing secret). Bot scopes: chat:write, channels:read, groups:read, channels:join.
# Redirect URL to register in the Slack app: <APP_BASE_URL>/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Verifies inbound Slack requests (X-Slack-Signature); copied into each connection's webhook bundle when a channel is picked.
SLACK_SIGNING_SECRET=
# API base override (staging stub / Cypress mock base URL). Unset = https://slack.com/api.
SLACK_API_BASE=
# --- Google Calendar + Gmail (T042). Names only. Same OAuth client as above; redirect URIs /api/oauth/google-calendar|gmail/callback. ---
# Publishing status of the Google OAuth app: "testing" (max 100 named test users) or "production". Gmail (restricted scope) is usable only in "testing",
# or in "production" once GOOGLE_OAUTH_CASA_COMPLETE=true. Unset = Gmail stays closed.
GOOGLE_OAUTH_APP_MODE=
GOOGLE_OAUTH_CASA_COMPLETE=
GOOGLE_CALENDAR_API_BASE=
GMAIL_API_BASE=
# --- Outlook / Microsoft 365 (T043). One multi-tenant Entra ID app (redirect URI /api/oauth/outlook/callback); names only. Graph base override for stubs / Cypress; unset = Microsoft. ---
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_GRAPH_API_BASE=
# --- OTA: channel manager + iCal (T046). Names only. The partner is not chosen (B-6); unset = the generic adapter refuses to call out, sandbox fixtures still work. ---
CHANNEL_MANAGER_API_BASE=


# --- Zoho CRM + HubSpot two-way sync and migration import (T048). Names only: values come from the deployment, never from code. ---
# Zoho OAuth client (api-console.zoho.in for the India data centre). Redirect URI: <app>/api/oauth/zoho-crm/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Default data centre for a connection that has none stored: in (default), us, eu, au, jp, ca, sa, cn.
ZOHO_DEFAULT_REGION=
# Stub overrides (Cypress mock bases / local). Unset = the region's real Zoho hosts.
ZOHO_ACCOUNTS_URL=
ZOHO_API_BASE=
# HubSpot app (developer account). Redirect URI: <app>/api/oauth/hubspot/callback. The client secret also signs webhooks (X-HubSpot-Signature-v3).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Stub override (Cypress mock base / local). Unset = https://api.hubapi.com
HUBSPOT_API_BASE=

# --- Platform legal pages (AUD-011): /legal/privacy, /legal/terms, /legal/data-deletion. Names only: values come from the deployment, never from code. ---
# All eight required values must be set before the pages are indexable; while any is missing the pages show a DRAFT banner and send noindex.
PLATFORM_LEGAL_NAME=
PLATFORM_REGISTERED_ADDRESS=
PLATFORM_CONTACT_EMAIL=
PLATFORM_GRIEVANCE_OFFICER_NAME=
PLATFORM_GRIEVANCE_OFFICER_EMAIL=
PLATFORM_JURISDICTION_CITY=
PLATFORM_LEGAL_EFFECTIVE_DATE=
PLATFORM_DATA_REGION=
# Optional. Unset = neutral wording ("without undue delay"); set a number of days only if the operator will honour it. The product does not delete collected metrics automatically: deletion is on request.
PLATFORM_PRODUCT_NAME=
PLATFORM_DELETION_RESPONSE_DAYS=
PLATFORM_GRIEVANCE_RESPONSE_DAYS=
PLATFORM_LIABILITY_CAP_MONTHS=
# Meta data-deletion callback (AUD-088): POST <app>/api/meta/data-deletion, verified with META_APP_SECRET (above). Needs migration 0024 applied.
