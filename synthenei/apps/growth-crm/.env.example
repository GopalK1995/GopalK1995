# Copy to .env.local. Never commit real values.

# production | staging | demo | test. Unset = demo when no Supabase env, else staging.
# production refuses DEMO_MODE=1 and requires the Supabase keys, SESSION_SECRET (32+ chars) and JOBS_TICK_SECRET.
APP_ENV=demo
APP_BASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
JOBS_TICK_SECRET=
CRON_SECRET=

# --- Supabase (optional). Without these the app runs fully in demo mode on synthetic data. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Read real tables for real (non-demo) sessions: "supabase". Demo sessions always read the mock.
DATA_SOURCE=mock

# --- Security switches (server-only) ---
# Signs the session, workspace and support cookies. REQUIRED when Supabase is configured.
SESSION_SECRET=
# Demo personas on /login and the demo admin MFA step. Leave OFF (unset or 0) for a client production deployment.
# When Supabase is not configured, demo mode is always on (there is nothing real to protect).
DEMO_MODE=0
# Local http testing of a production build only.
INSECURE_COOKIES=0

# --- Later integrations (not implemented) ---
BACKUP_ADAPTER=mock
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_REF=
ANTHROPIC_API_KEY=
