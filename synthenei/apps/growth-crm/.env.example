# Copy to .env.local. Never commit real values.

# production | staging | demo | test. Unset = demo when no Supabase env, else staging.
# production refuses DEMO_MODE=1 and requires the Supabase keys, SESSION_SECRET (32+ chars) and JOBS_TICK_SECRET.
APP_ENV=demo
APP_BASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
JOBS_TICK_SECRET=
CRON_SECRET=

# --- Supabase (optional). Without these the app runs fully in demo mode on synthetic data. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Read real tables for real (non-demo) sessions: "supabase". Demo sessions always read the mock.
DATA_SOURCE=mock

# --- Security switches (server-only) ---
# Signs the session, workspace and support cookies. REQUIRED when Supabase is configured.
SESSION_SECRET=
# Demo personas on /login and the demo admin MFA step. Leave OFF (unset or 0) for a client production deployment.
# When Supabase is not configured, demo mode is always on (there is nothing real to protect).
DEMO_MODE=0
# Local http testing of a production build only.
INSECURE_COOKIES=0

# --- Later integrations (not implemented) ---
BACKUP_ADAPTER=mock
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_REF=
ANTHROPIC_API_KEY=

# --- WhatsApp Business (T035). Names only: values come from the deployment, never from code. ---
# Graph API base override (staging stub / Cypress). Unset = Meta's default. Version override likewise.
WHATSAPP_API_BASE=
WHATSAPP_API_VERSION=
# Platform Meta app for embedded signup (optional; manual connection needs none of these).
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Webhook handshake token for the Meta callback URL (shared fallback; a connection can also carry its own verify_token).
META_WEBHOOK_VERIFY_TOKEN=

# --- Meta Lead Ads + Instagram + Ads Insights (T036). Names only: values come from the deployment, never from code. ---
# The platform Meta app (Facebook Login client). The secret also signs webhooks (X-Hub-Signature-256) and appsecret_proof.
META_APP_ID=
META_APP_SECRET=
# Graph API base / version override (staging stub / Cypress insights mock). Unset = Meta default.
META_GRAPH_API_BASE=
META_GRAPH_API_VERSION=
# --- Razorpay, tenant payments (T037). Names only. Tenants paste their own keys in the app (stored encrypted); nothing here is a key. ---
# API base override (staging stub / Cypress). Unset = Razorpay's default. The platform billing RAZORPAY_KEY_* names are a separate feature.
RAZORPAY_API_BASE=

# --- Email: outbound (Resend / SMTP) and Mailchimp (T038). Names only. Tenants paste their own provider credentials in the app (stored encrypted). ---
# Resend API base override (staging stub / Cypress). Unset = Resend's default.
RESEND_API_BASE=
# Signing key for unsubscribe links (32+ random characters). Required before any email can be sent: mail without a working opt-out is blocked.
EMAIL_UNSUBSCRIBE_SECRET=
# Platform-level default sender for SYSTEM mail only (invites, notifications). Never used for a tenant's own email; leave empty to disable.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Mailchimp OAuth app (platform-owned) and an optional API base override for stubs.
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
MAILCHIMP_API_BASE=
# --- Google: Analytics 4, Google Ads, Sheets import (T039). Names only: values come from the deployment, never from code. ---
# One Google Cloud OAuth client for all three connectors (redirect URIs: /api/oauth/ga4|google-ads|google-sheets/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Ads developer token (test accounts work before basic access is granted) and an optional manager (MCC) customer id.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# API base / version overrides (staging stub / Cypress mock base URLs). Unset = Google's defaults.
GOOGLE_ADS_API_BASE=
GOOGLE_ADS_API_VERSION=
GA4_DATA_API_BASE=
GA4_ADMIN_API_BASE=
GOOGLE_SHEETS_API_BASE=
