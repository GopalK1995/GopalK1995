{
  "baseUrl": "{{connection.base_url}}/api/v1",
  "headers": {
    "Authorization": "Bearer {{connection.api_key}}",
    "Accept": "application/json"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{body.title}}{{ifempty(' - ' + body.detail, '')}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
