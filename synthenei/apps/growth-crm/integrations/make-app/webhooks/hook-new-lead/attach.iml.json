{
  "url": "/webhooks",
  "method": "POST",
  "headers": {
    "Idempotency-Key": "{{sha256(webhook.url)}}"
  },
  "body": {
    "url": "{{webhook.url}}",
    "event_types": [
      "lead.created"
    ],
    "description": "Make"
  },
  "response": {
    "data": {
      "id": "{{body.data.id}}"
    }
  }
}
