# Lead intake -> Supabase (Growth CRM). When URL + anon/publishable key are set, /api/leads calls the
# SECURITY DEFINER RPC public.submit_lead (validated, throttled; writes leads + consent_log + lead_events).
# The anon key cannot read any table. Values go in .env.local (gitignored), never in the repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias for the URL (server-only)
SUPABASE_URL=
# Workspace slug or id that receives landing leads (default: lawsome-tn = "LAWSOME · Tamil Nadu")
NEXT_PUBLIC_LEAD_WORKSPACE=lawsome-tn
# Privacy notice version recorded in consent_log
PRIVACY_NOTICE_VERSION=v1

# Optional server-only fallback key if no anon key is configured (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Slack/Zapier webhook for new-lead notifications (name, role, firm + CRM link only)
LEAD_WEBHOOK_URL=
# Optional: CRM base URL used to build the lead link in the notification
CRM_BASE_URL=
