#!/bin/sh
# Opt-in pre-commit hook (AUD-054). Enable once per clone: npm --prefix synthenei/apps/growth-crm run hooks:install
# No dependency and no install-time script, so it cannot break `npm ci`. Bypass in an emergency: git commit --no-verify.
APP=synthenei/apps/growth-crm
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT/$APP" || exit 0
[ -d node_modules ] || { echo "pre-commit: node_modules missing, skipping checks"; exit 0; }
STAGED=$(git diff --cached --name-only --diff-filter=ACM -- . | grep -E '\.(ts|tsx|js|jsx|mjs)$' | sed "s#^$APP/##")
[ -z "$STAGED" ] && exit 0
echo "pre-commit: eslint (errors only) on staged files"
# shellcheck disable=SC2086
npx --no-install eslint --quiet $STAGED || exit 1
echo "pre-commit: tsc --noEmit"
npx --no-install tsc --noEmit || exit 1
exit 0
