# Copy to .env and fill in. Never commit .env.
N8N_HOST=n8n.example.com          # DNS A record must point to this server
GENERIC_TIMEZONE=Asia/Kolkata
N8N_VERSION=latest                # pin e.g. 1.x.y for production

POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=change-me       # openssl rand -hex 24

# Encrypts stored credentials. Generate once, back it up, never change it.
N8N_ENCRYPTION_KEY=change-me      # openssl rand -hex 32
